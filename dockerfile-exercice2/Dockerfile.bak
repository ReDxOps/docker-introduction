ARG NODE_VERSION=22.23.5-alpine3.24@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a

FROM node:${NODE_VERSION}

WORKDIR /app

RUN npm install -g serve

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build && rm -rf node_modules/

EXPOSE 3000

CMD ["serve", "-s", "dist"]
